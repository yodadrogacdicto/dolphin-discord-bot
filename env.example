DISCORD_TOKEN=pon_aqui_el_token_del_bot
# OpenRouter es GRATIS (solo el modelo :free). Opcional: sin key el bot usa solo AI Horde.
OPENROUTER_API_KEY=
# Opcional: key gratis de https://aihorde.net/register (da más prioridad que la anónima 0000000000)
HORDE_API_KEY=0000000000
# Opcional: orden de proveedores
PROVIDER_ORDER=openrouter,horde,fallback
# Opcional
# (el dolphin :free ya no existe en OpenRouter; el bot usa los sin censura de AI Horde y luego estos gratis)
OPENROUTER_FALLBACK=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
MAX_TOKENS=4096
HORDE_MAX_TOKENS=512
# GitHub token (repo + workflow): compila APK/EXE y publica webs en Pages. Ponlo SOLO en Secrets/.env
GITHUB_TOKEN=
# IDs de Discord (separados por coma) que pueden ejecutar código con el bot. Vacío = desactivado
OWNER_IDS=

# Proveedor extra opcional (API compatible con OpenAI con tier gratis y modelos sin censura)
# EXTRA_BASE_URL=https://tu-proveedor/v1
# EXTRA_API_KEY=
# EXTRA_MODELS=nombre-del-modelo-uncensored
