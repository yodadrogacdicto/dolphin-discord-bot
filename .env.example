# ==============================================================
#  VARIABLES DEL BOT  ->  ponlas en Railway > pestaña "Variables"
#  OBLIGATORIAS: DISCORD_TOKEN, OWNER_IDS, GITHUB_TOKEN
#  Todo lo demas es OPCIONAL: si lo dejas vacio usa el valor por defecto.
# ==============================================================

# ---------------- OBLIGATORIAS ----------------
# Token del bot: discord.com/developers > tu app > Bot > Reset Token
DISCORD_TOKEN=

# Tu ID de Discord (separados por coma si son varios). Sin esto no hay
# ejecucion de codigo, webhooks ni GitHub. Se saca con Modo Desarrollador
# activo: clic derecho sobre tu avatar > "Copiar ID".
OWNER_IDS=

# Token de GitHub (classic o fine-grained con permiso repo + workflow).
# Compila APK/EXE, lee repos y publica en Pages.
GITHUB_TOKEN=

# ---------------- RECOMENDADA (gratis) ----------------
# Key de https://aihorde.net/register . Da mas prioridad que la anonima.
# Puedes dejar la anonima: 0000000000
HORDE_API_KEY=0000000000

# ---------------- PROVEEDORES DE PAGO (opcionales) ----------------
# Sin su key, ese proveedor se salta solo. AI Horde siempre es gratis.
VENICE_API_KEY=
UNLID_API_KEY=
HEABSY_API_KEY=
REFUSELESS_API_KEY=

# ---------------- PROVEEDOR EXTRA (opcional) ----------------
# Cualquier API compatible con OpenAI que tenga modelos sin censura.
EXTRA_BASE_URL=
EXTRA_API_KEY=
EXTRA_MODELS=

# ---------------- ORDEN DE PROVEEDORES ----------------
# Se prueba de izquierda a derecha hasta que uno responda.
PROVIDER_ORDER=horde,venice,unlid,heabsy,refuseless,extra

# ---------------- MODELOS (opcionales) ----------------
# Vacio = usa la lista que ya viene en el codigo (19 de Horde).
# Solo se aceptan nombres sin censura (uncensored / heretic / abliterated...).
HORDE_MODELS=
VENICE_MODELS=
UNLID_MODELS=
HEABSY_MODELS=
REFUSELESS_MODELS=

# ---------------- AJUSTES DE IA (opcionales) ----------------
MAX_TOKENS=8192
TEMPERATURE=0.7
HISTORY_TURNS=8
MAX_CONTEXT_CHARS=60000
FILE_CHAR_BUDGET=40000
RAW_FILES=1

# ---------------- AJUSTES DE HORDE (opcionales) ----------------
HORDE_MAX_TOKENS=1024
HORDE_MAX_CONTEXT_CHARS=10000
HORDE_TIMEOUT=180
LLM_TOTAL_TIMEOUT=600

# ---------------- SERVIDOR ----------------
# Railway la pone solo; no hace falta tocarla.
PORT=8080
