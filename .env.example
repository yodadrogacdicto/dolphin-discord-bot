# ==============================================================
#  VARIABLES DEL BOT  ->  ponlas en Railway > pestaña "Variables"
#  OBLIGATORIAS: DISCORD_TOKEN. OWNER_IDS habilita funciones del dueño.
#  GITHUB_TOKEN es necesario para publicar y modificar repos.
#  Todo lo demas es OPCIONAL: si lo dejas vacio usa el valor por defecto.
# ==============================================================

# ---------------- OBLIGATORIAS ----------------
# Token del bot: discord.com/developers > tu app > Bot > Reset Token
DISCORD_TOKEN=

# Tu ID de Discord (separados por coma si son varios). Sin esto no hay
# ejecucion de codigo, webhooks ni GitHub. Se saca con Modo Desarrollador
# activo: clic derecho sobre tu avatar > "Copiar ID".
OWNER_IDS=

# Token de GitHub (classic o fine-grained con permiso repo + workflow).
# Compila APK/EXE, lee repos y publica en Pages.
GITHUB_TOKEN=

# ---------------- RECOMENDADA (gratis) ----------------
# Key de https://aihorde.net/register . Da mas prioridad que la anonima.
# Puedes dejar la anonima: 0000000000
HORDE_API_KEY=0000000000

# ---------------- RESPALDO DE MODELO GRATUITO (opcional) ----------------
# Solo se aceptan modelos :free que también coincidan con el filtro del catálogo.
# AI Horde sigue funcionando gratis sin esta API key.
OPENROUTER_API_KEY=
OPENROUTER_MODELS=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
HORDE_MODELS=

# ---------------- AJUSTES DE IA (opcionales) ----------------
MAX_TOKENS=8192
TEMPERATURE=0.7
HISTORY_TURNS=8
MAX_CONTEXT_CHARS=60000
FILE_CHAR_BUDGET=40000
RAW_FILES=1
MEMORY_DB_PATH=/app/data/memories.sqlite3

# ---------------- AJUSTES DE HORDE (opcionales) ----------------
HORDE_MAX_TOKENS=1024
HORDE_MAX_CONTEXT_CHARS=10000
HORDE_TIMEOUT=180
LLM_TOTAL_TIMEOUT=600

# ---------------- FORMULARIOS WEB -> DISCORD ----------------
# URL secreta del webhook: guárdala en Variables/Secrets, nunca en index.html.
DISCORD_WEBHOOK_URL=
# Origen exacto de GitHub Pages, por ejemplo https://tuusuario.github.io
WEBHOOK_ALLOWED_ORIGINS=
# URL pública del servicio Railway; Dolphin la incluye en el código que genera.
# Ejemplo: https://tu-bot.up.railway.app
WEBHOOK_API_URL=

# ---------------- SERVIDOR ----------------
# Railway la pone solo; no hace falta tocarla.
PORT=8080
